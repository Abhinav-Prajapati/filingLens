# Copy to .env (git-ignored) and fill in. Any OpenAI-compatible endpoint works.
#
# vLLM:       vllm serve Qwen/Qwen2.5-7B-Instruct --enable-auto-tool-choice --tool-call-parser hermes
#             -> FILINGLENS_LLM_BASE_URL=http://localhost:8000/v1
# Ollama:     ollama pull qwen2.5:7b      -> FILINGLENS_LLM_BASE_URL=http://localhost:11434/v1
# llama.cpp:  llama-server -m qwen2.5-7b-instruct-q4_k_m.gguf --jinja -> http://localhost:8080/v1
# Groq:       FILINGLENS_LLM_BASE_URL=https://api.groq.com/openai/v1, key from console.groq.com,
#             model e.g. qwen/qwen3-32b (list models: see README)
# Hosted:     the provider's OpenAI-compatible base URL and your key
FILINGLENS_LLM_BASE_URL=http://localhost:8000/v1
FILINGLENS_LLM_API_KEY=changeme
FILINGLENS_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# native = OpenAI tool calling; json = plain-JSON replies for servers without tool support
FILINGLENS_LLM_TOOLS=native
# FILINGLENS_LLM_TEMPERATURE=0
# FILINGLENS_LLM_MAX_TOKENS=400
# FILINGLENS_LLM_TIMEOUT=60

# --- infrastructure (docker compose) ---
# Postgres (compose publishes it on 127.0.0.1:5442)
FILINGLENS_PG_PASSWORD=change-me
FILINGLENS_DATABASE_URL=postgresql://filinglens:change-me@127.0.0.1:5442/filinglens
# S3-compatible store (SeaweedFS; S3 API on 127.0.0.1:8333, browser UI on 127.0.0.1:8090)
FILINGLENS_S3_ENDPOINT=http://127.0.0.1:8333
FILINGLENS_S3_BUCKET=filinglens
FILINGLENS_S3_ACCESS_KEY=change-me
FILINGLENS_S3_SECRET_KEY=change-me-too
# signs password-reset / verification tokens
FILINGLENS_AUTH_SECRET=change-me
